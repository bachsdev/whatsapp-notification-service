# Required — all /notify and /connect requests must include X-API-Key: <value>
API_KEY=your-secret-key-here

# Required for AI replies — get from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Optional
SERVICE_NAME=WhatsApp Notification Service
PORT=3000
LOG_LEVEL=info

# Required on Railway/cloud hosts where WhatsApp blocks the egress IP
# Use any HTTP/HTTPS/SOCKS5 proxy URL, e.g. from Fixie, Bright Data, etc.
# PROXY_URL=http://user:pass@proxy.example.com:8080

# pm-agent (the Lady Bachs agent service)
# AGENT_WEBHOOK_URL=https://pm-agent.example.com      # base URL or the full /webhook URL
# AGENT_WEBHOOK_KEY=shared-key                        # must match pm-agent's PMAGENT_BACHS_INBOUND_KEY
# Groups pm-agent owns, comma separated. Every message there goes to pm-agent and the
# built-in AI never replies there.
# AGENT_GROUPS=120363411324724934@g.us
# Set to false to turn off the built-in AI replies everywhere.
# LADY_BACHS_ENABLED=true
